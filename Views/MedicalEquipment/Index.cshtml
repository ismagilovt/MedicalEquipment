@model IEnumerable<MyMvcApp.Models.MedicalEquipment>

@{
    ViewData["Title"] = "Медицинское оборудование";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Добавить оборудование</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.Manufacturer)</th>
            <th>@Html.DisplayNameFor(model => model.Model)</th>
            <th>@Html.DisplayNameFor(model => model.Location)</th>
            <th>@Html.DisplayNameFor(model => model.IsActive)</th>
            <th>@Html.DisplayNameFor(model => model.NextMaintenanceDate)</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Manufacturer)</td>
                <td>@Html.DisplayFor(modelItem => item.Model)</td>
                <td>@Html.DisplayFor(modelItem => item.Location)</td>
                <td>@(item.IsActive ? "Да" : "Нет")</td>
                <td>@Html.DisplayFor(modelItem => item.NextMaintenanceDate)</td>
                <td>
    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Подробнее</a>
    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Изменить</a>

    <form asp-action="Delete" asp-route-id="@item.Id" method="post"
          data-name="@item.Name" onsubmit="return confirmDelete(this.dataset.name)" style="display:inline;">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
    </form>
</td>

            </tr>
        }
    </tbody>
</table>
